{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gymtracker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "vasilispngs.cloudflareaccess.com",
    "ACCESS_AUD": "4f792d7de653fa38d86a34275b077189147ff0b54f766c2f2f67c9d30d93155e"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gymtracker",
      "database_id": "9fba0415-e994-42c4-8118-a5824b80f29d",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
