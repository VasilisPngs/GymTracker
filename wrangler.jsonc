{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gymtracker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "vasilispngs.cloudflareaccess.com",
    "ACCESS_AUD": "458ef3f9ff0d01f4b9c7311a29e40128ff293865dbb0307c6fe0fac7bbb8a5f7"
  },
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gymtracker",
      "database_id": "9fba0415-e994-42c4-8118-a5824b80f29d",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
