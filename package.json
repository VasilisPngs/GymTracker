{
  "name": "gymtracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npx wrangler d1 migrations apply DB --remote && npx wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "4.138.0"
  }
}
